/*
 * PAW3395 trackball sensor for the right half (replaces charybdis_pmw3610.dtsi).
 *
 * PAW3395 uses 4-wire SPI, so MOSI and MISO need separate pins
 * (PMW3610 shared one SDIO line on P0.17).
 *
 *   Signal   nRF52840  SuperMini / nice!nano pin   Wire
 *   SCLK     P0.08     D0 (RX)    (pro_micro 0)    existing FFC wire "SCLK"
 *   MOTION   P0.06     D1 (TX)    (pro_micro 1)    existing FFC wire "MOTION"
 *   MISO     P0.17     D2         (pro_micro 2)    existing FFC wire "SDIO"
 *   nCS      P0.20     D3         (pro_micro 3)    existing FFC wire "NCS"
 *   MOSI     P1.11     D14 "1.11" (pro_micro 14)   NEW 7th wire
 *   VIN      3.3V VCC                              existing FFC wire "VCC"
 *   GND      GND                                   existing FFC wire "GND"
 */

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 1, 11)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 1, 11)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

#include <zephyr/dt-bindings/input/input-event-codes.h>

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3395";
        reg = <0>;
        /* ~10 cm FFC: 2 MHz is conservative; driver example uses 4 MHz */
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <800>; /* 50..26000, step 50 */
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        /* Orientation depends on how the sensor sits on the new PCB.
           Start with the PMW3610 values; flip as needed after first test. */
        swap-xy;
        invert-x;
        invert-y;

        /* Full performance while ZMK is ACTIVE, drops back when IDLE/SLEEP */
        force-awake;
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled"; // overridden on central
        device = <&trackball_split>;
    };
};
